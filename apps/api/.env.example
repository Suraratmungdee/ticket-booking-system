DATABASE_URL="postgresql://ticket:ticket@localhost:5432/ticket_booking"
JWT_SECRET="change-me-in-production"
FRONTEND_ORIGIN="http://localhost:3000"
PORT=4000
# Only set to "true" when this API is deployed behind a trusted reverse
# proxy (nearly every PaaS). It makes Express trust X-Forwarded-For for
# req.ip, which the login rate limiter keys on. Leaving it unset is safer
# with no proxy in front; enabling it with no proxy in front lets a client
# spoof its own IP and dodge the login rate limiter.
# TRUST_PROXY=true
