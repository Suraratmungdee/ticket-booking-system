DATABASE_URL="postgresql://ticket:ticket@localhost:5432/ticket_booking"
JWT_SECRET="dev-secret-change-me"
FRONTEND_ORIGIN="http://localhost:3000"
PORT=4000
# Only set to "true" when this API is deployed behind a trusted reverse
# proxy (nearly every PaaS). It makes Express trust X-Forwarded-For for
# req.ip, which the login rate limiter keys on. Leaving it unset is safer
# with no proxy in front; enabling it with no proxy in front lets a client
# spoof its own IP and dodge the login rate limiter.
# TRUST_PROXY=true
# Only set to "true" when apps/web and apps/api are on different registrable
# domains (e.g. a *.vercel.app frontend calling a *.onrender.com backend)
# but NODE_ENV is deliberately not "production" (a staging/demo deploy with
# PAYMENT_PROVIDER=mock, which refuses to boot under NODE_ENV=production).
# Without this, the session cookie is set with SameSite=Lax and never comes
# back cross-site — login looks like it works but every later request is
# anonymous. Always "true" already when NODE_ENV=production.
# COOKIE_CROSS_SITE=true
REDIS_URL="redis://localhost:6379"
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret-change-me"
API_BASE_URL="http://localhost:4000"
TICKET_SIGNING_SECRET="dev-ticket-secret-change-me"
RESEND_API_KEY=""
EMAIL_FROM="tickets@example.com"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
